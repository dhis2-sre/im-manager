# consumedParameters: DATABASE_USERNAME, DATABASE_NAME, DATABASE_HOSTNAME
# hostnameVariable: DATABASE_HOSTNAME
helmDefaults:
  createNamespace: false

releases:
  - name: {{ requiredEnv "INSTANCE_NAME" }}-pgadmin
    namespace: "{{ requiredEnv "INSTANCE_NAMESPACE" }}"
    chart: runix/pgadmin4
    version: "{{ requiredEnv "CHART_VERSION" }}"
    values:
      - commonLabels:
          im: "true"
          im-default: "true"
          im-deployment-id: "{{ requiredEnv "DEPLOYMENT_ID" }}"
          im-instance-id: "{{ requiredEnv "INSTANCE_ID" }}"
          im-id: "{{ requiredEnv "INSTANCE_ID" }}"
          im-type: "pgadmin"
          im-creation-timestamp: "{{ requiredEnv "INSTANCE_CREATION_TIMESTAMP" }}"
          im-ttl: "{{ requiredEnv "INSTANCE_TTL" }}"

      # Without a request the scheduler counts pgAdmin as free and packs nodes past their memory. It
      # uses about 150Mi.
      - resources:
          requests:
            memory: 192Mi

      # The pgAdmin volume attaches to one node at a time, so a rolling update whose new pod lands on
      # another node waits forever for the old pod to let go of it. rollingUpdate is cleared because
      # the API server keeps its defaults on deployments created before this change.
      - strategy:
          type: Recreate
          rollingUpdate: null

      - ingress:
          enabled: true
          hosts:
            - host: {{ requiredEnv "INSTANCE_HOSTNAME" }}
              paths:
                - path: /{{ requiredEnv "INSTANCE_PATH_NAME" }}-pgadmin
                  pathType: Prefix
          {{- if env "CERT_ISSUER" }}
          annotations:
            cert-manager.io/cluster-issuer: "{{ env "CERT_ISSUER" }}"
            ingress.kubernetes.io/ssl-redirect: "true"
          {{- end }}
          {{- if env "CERT_ISSUER" }}
          tls:
            - secretName: "{{ requiredEnv "INSTANCE_HOSTNAME" | replace "." "-" }}-tls"
              hosts:
                - {{ requiredEnv "INSTANCE_HOSTNAME" | quote }}
          {{- end }}
      - env:
          # TODO: https://jira.dhis2.org/browse/DEVOPS-136
          email: {{ requiredEnv "PGADMIN_USERNAME" }}
          password: {{ requiredEnv "PGADMIN_PASSWORD" | quote }}
          contextPath: /{{ requiredEnv "INSTANCE_PATH_NAME" }}-pgadmin
      - serverDefinitions:
          enabled: true
          servers:
            server:
              Name: {{ requiredEnv "INSTANCE_PATH_NAME" }}
              Group: Servers
              Port: 5432
              Username: {{ requiredEnv "DATABASE_USERNAME" }}
              Host: {{ requiredEnv "DATABASE_HOSTNAME" }}
              SSLMode: prefer
              MaintenanceDB: {{ requiredEnv "DATABASE_NAME" }}

repositories:
  - name: runix
    url: https://helm.runix.net
